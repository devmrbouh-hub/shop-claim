{
  "name": "shop-claim-portal-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:landing": "vite --config vite.landing.config.ts",
    "build": "tsc -b && vite build",
    "build:landing-assets": "node scripts/build-landing-marketing-assets.mjs",
    "build:landing": "npm run build:landing-assets && tsc -b && vite build --config vite.landing.config.ts",
    "preview": "vite preview",
    "preview:landing": "vite preview --config vite.landing.config.ts --outDir dist-landing"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@hookform/resolvers": "^5.4.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@tailwindcss/vite": "^4.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.23.0",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.80.0",
    "react-router-dom": "^6.28.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "sharp": "^0.34.5",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
